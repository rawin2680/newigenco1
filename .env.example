# ==========================================
# VERDANT HEADLESS ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIG (PostgreSQL)
POSTGRES_USER=strapi_user
POSTGRES_PASSWORD=strapi_secure_password_2026
POSTGRES_DB=strapi_db
POSTGRES_PORT=5432

# 2. BACKEND CONFIG (Strapi CMS)
APP_KEYS=verdantAppKey1,verdantAppKey2,verdantAppKey3,verdantAppKey4
API_TOKEN_SALT=verdantApiTokenSaltRandom123
ADMIN_JWT_SECRET=verdantAdminJwtSecretRandom456
TRANSFER_TOKEN_SALT=verdantTransferSaltRandom789
JWT_SECRET=verdantUserJwtSecretRandom012

# 3. FRONTEND CONFIG (Nuxt 3)
FRONTEND_PORT=3001
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
