{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Contact Inquiry",
    "description": "ข้อมูลติดต่อสอบถามและขอคำปรึกษาจากหน้าเว็บไซต์"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "projectSummary": {
      "type": "text"
    },
    "blueprintSpec": {
      "type": "text"
    },
    "followUpStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "in_progress",
        "contacted",
        "closed"
      ],
      "default": "pending"
    },
    "adminNote": {
      "type": "text"
    }
  }
}
